{
  "editor.bracketPairColorization.enabled": true,
  "editor.fontFamily": "FiraCode Nerd Font",
  "editor.fontLigatures": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.bracketPairsHorizontal": true,
  "editor.guides.highlightActiveBracketPair": true,
  "editor.hover.delay": 1500,
  "editor.rulers": [
    100
  ],
  "editor.stickyScroll.enabled": false,
  "explorer.autoReveal": false,
  "files.associations": {
    "**/*.j2": "yaml",
    "*.json5": "json5",
    "**/*justfile": "just",
    "**/*.just": "just"
  },
  "files.trimTrailingWhitespace": true,
  "material-icon-theme.folders.associations": {
    "helmfile.yaml": "helm",
    "kubeconfig": "kubernetes",
    "talosconfig": "kubernetes",
    ".archive": "archive",
    ".github/workflows": "robot",
  },
  "vs-kubernetes": {
    "vs-kubernetes.kubeconfig": "./infrastructure/kubeconfig",
    "vs-kubernetes.knownKubeconfigs": [
      "./infrastructure/kubeconfig"
    ]
  },
  "window.zoomLevel": 0,
  "yaml.schemaStore.enable": true,
  "yaml.schemas": {
    "kubernetes": "./infrastructure/**/*.yaml",
    "clusters": "./clusters/**/*.yaml"
  },
  "[just]": {
    "editor.defaultFormatter": "nefrob.vscode-just-syntax"
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json5]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
